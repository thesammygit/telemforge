  "implementation_status": "reconnect_resume_runtime_probe_only",
  "purpose": "Pin the next narrow runtime evidence slice for Stage 09 live telemetry reconnect behavior without claiming backpressure reporting, dropped-event measurement, sustained fanout, runtime promotion readiness, or a Rust whole-project rewrite.",
  "endpoint": {
    "protocol": "websocket",
    "path": "/sessions/{session_id}/telemetry/live",
    "session_id_source": "existing session created through POST /sessions",
    "resume_query_parameter": "after_sequence"
  },
  "verification": {
    "command": "python3 -m unittest discover -s tests/backend -p 'test_stage09_live_stream.py'",
    "test_file": "tests/backend/test_stage09_live_stream.py",
    "supporting_contract": "docs/development/artifacts/stage09-realtime-baseline/stage09-live-telemetry-contract.json",
    "supporting_prior_artifacts": [
      "docs/development/artifacts/stage09-realtime-baseline/stage09-live-stream-first-snapshot.json",
      "docs/development/artifacts/stage09-realtime-baseline/stage09-live-stream-monotonic-sequence.json"
    ],
    "supporting_checklist": "docs/development/artifacts/stage09-realtime-baseline/stage09-runtime-stream-evidence-checklist.json",
    "proved_claims": [
      "after_sequence=1 reconnect resumes with a contract-compatible telemetry.sample message",
      "resumed per-session stream sequence remains greater than the requested value",
      "out-of-window reconnect preserves the documented stream.snapshot fallback before follow-on delivery"
    ]
  },
  "deterministic_probe_inputs": {
    "simulation_route": "/sessions/{session_id}/simulations",
    "fault_route": "/sessions/{session_id}/faults",
    "scenario": "nominal-orbit-daylight",
    "simulation_start_at": "2026-05-15T00:00:00Z",
    "samples": 2,
    "step_seconds": 10,
    "seed": 4404,
    "fault_type": "comms_downlink_fade",
    "fault_requested_at": "2026-05-15T00:10:00Z"
  },
  "reconnect_vectors": [
    {
      "name": "resume_from_first_incremental_sequence",
      "client_query": {
        "after_sequence": 1
      },
      "expected_first_message": {
        "type": "telemetry.sample",
        "sequence": 2,
        "payload_assertions": {
          "channel_id": "comms.downlink_snr_db",
          "timestamp": "2026-05-15T00:10:00Z",
          "status": "critical",
          "quality": "suspect",
          "unit": "dB",
          "sequence": 0
        }
      }
    },
    {
      "name": "fallback_when_sequence_is_outside_retained_window",
      "client_query": {
        "after_sequence": 99
      },
      "expected_first_message": {
        "type": "stream.snapshot",
        "sequence": 1,
        "payload_assertions": {
          "channels_source": "fixtures/telemetry/channels.json",
          "active_alert_channel_ids": [
            "comms.downlink_snr_db",
            "comms.packet_error_rate_pct"
          ]
        }
      },
      "expected_follow_on_message": {
        "type": "telemetry.sample",
        "sequence": 2,
        "payload_assertions": {
          "channel_id": "comms.downlink_snr_db",
          "timestamp": "2026-05-15T00:10:00Z",
          "status": "critical",
          "quality": "suspect",
          "unit": "dB",
          "sequence": 0
        }
      }
    }
  ],
  "blocked_claims": [
    "drop_oldest_and_report backpressure behavior",
    "stream-based dropped_event_count reporting",
    "runtime websocket fanout or promotion readiness"
  ],
